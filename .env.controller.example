CHOUKA_ENROLLMENT_TOKEN=replace-with-a-long-random-token
CHOUKA_BIND_ADDRESS=127.0.0.1
CHOUKA_PORT=8199
# 反向代理部署时必须填写浏览器访问的完整来源；HTTPS 来源自动启用安全 Cookie。
CHOUKA_AUTH_ORIGIN=
# 默认使用 HTTP。配置 TLS 证书和私钥后，HTTPS 网页临时跳回
# http://dinghaichouka.youku.com:8199（端口跟随 CHOUKA_PORT）；可用此项覆盖 HTTP 目标。
CHOUKA_HTTP_REDIRECT_ORIGIN=
# 可选：显式恢复 HTTP→HTTPS，与上面的 HTTP 目标不能同时填写。
# 两个方向均保留路径和查询，不跳转 API、Worker、WebSocket 或 POST；本地隔离模式不启用。
# 反向代理部署时在代理入口配置跳转，勿重复配置；CHOUKA_AUTH_ORIGIN 须与最终入口一致。
CHOUKA_HTTPS_REDIRECT_ORIGIN=
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=
# 钉钉注册审批（可选）：全部留空则不启用，注册接口返回 503；部分填写会启动失败。
# 服务器出口 IP 需加入钉钉应用白名单，否则发卡 403。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
# 两位指定审批人的平台 userId（工号），逗号分隔；任意一人先决生效
DINGTALK_APPROVERS=
# 审批群会话 ID（群内 @机器人 发消息由回调捕获，或从钉钉管理端获取）
DINGTALK_GROUP_CONVERSATION_ID=
# 卡片模板 ID；留空使用默认
DINGTALK_CARD_TEMPLATE_ID=107b6afb-a8b7-4dbe-9cb0-baafd1c7839f.schema
# 机器人 robotCode，留空默认同 APP_KEY
DINGTALK_ROBOT_CODE=
# 生成任务运行超过 35 分钟告警（可选）：留空仅停用任务告警，注册审批不受影响。
# 沿用上述 APP/GROUP/APPROVERS 配置，仅同一群内现有两位注册审批人可操作。
# 必须使用独立告警模板，变量：title/workerName/workerId/taskName/jobId/projectName/cardId/
# submitter/startTime/elapsedText/status/resultText/restartEnabled/lastMessage。
# 按钮动作固定 restart_task_services，文案“重启该节点服务（中断当前任务）”；
# 仅 restartEnabled 为字符串 true 时可点击，其余禁用并展示 resultText 原因。
# status：alerting/expired/restart_pending/restart_running/restart_done/restart_error。
# 仅支持受约束重启的新 Worker 可用；旧 Worker 只告警，不开放任意命令或重启。
DINGTALK_TASK_ALERT_TEMPLATE_ID=
# 参考图视频超分（可选）：不要在这里填 OSS 密钥。
# 本地把 sr-service.json.例子 复制为仓库根目录的 sr-service.json（已 gitignore），
# 在 oss.access_key_id / oss.access_key_secret 里填写；未配置时画布不显示该模式。
# Docker 控制器把同一份文件挂到 data/sr-service.json，或用 CHOUKA_SR_CONFIG 指过去。
