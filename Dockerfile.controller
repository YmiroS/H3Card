FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CHOUKA_EXECUTION_MODE=controller \
    CHOUKA_PORT=8199

WORKDIR /app

COPY requirements-controller.txt ./
RUN pip install --no-cache-dir -r requirements-controller.txt

COPY server/ server/
COPY web/ web/
COPY manifests/ manifests/
COPY graphs/ graphs/
COPY llm.json.例子 ./

RUN mkdir -p data/uploads data/artifacts data/projects

EXPOSE 8199
CMD ["python", "server/app.py"]
