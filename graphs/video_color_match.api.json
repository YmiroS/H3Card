{
 "1": {
  "class_type": "LoadVideo",
  "inputs": {"file": ""},
  "_meta": {"title": "加载镜头"}
 },
 "2": {
  "class_type": "GetVideoComponents",
  "inputs": {"video": ["1", 0]},
  "_meta": {"title": "拆出镜头画面与音频"}
 },
 "3": {
  "class_type": "LoadImage",
  "inputs": {"image": ""},
  "_meta": {"title": "加载参考图"}
 },
 "4": {
  "class_type": "ColorMatch",
  "inputs": {
   "image_ref": ["3", 0],
   "image_target": ["2", 0],
   "method": "mkl",
   "strength": 0.7,
   "multithread": true
  },
  "_meta": {"title": "按参考图校色"}
 },
 "5": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": ["4", 0],
   "audio": ["2", 1],
   "fps": ["2", 2],
   "bit_depth": "auto",
   "color_space": "sRGB",
   "codec": "none"
  },
  "_meta": {"title": "合成校色视频"}
 },
 "6": {
  "class_type": "SaveVideo",
  "inputs": {
   "video": ["5", 0],
   "filename_prefix": "video/Chouka_ColorMatch",
   "format": "auto",
   "format.codec": "auto"
  },
  "_meta": {"title": "保存校色视频"}
 }
}
