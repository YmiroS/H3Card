{
 "1": {
  "class_type": "VAELoader",
  "inputs": {"vae_name": "qwen_image_vae.safetensors"},
  "_meta": {"title": "加载 Qwen VAE"}
 },
 "2": {
  "class_type": "CLIPLoader",
  "inputs": {"clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors", "type": "qwen_image", "device": "default"},
  "_meta": {"title": "加载 Qwen 文本编码器"}
 },
 "3": {
  "class_type": "UNETLoader",
  "inputs": {"unet_name": "qwen_image_2512_fp8_e4m3fn.safetensors", "weight_dtype": "default"},
  "_meta": {"title": "加载 Qwen Image 2512"}
 },
 "4": {
  "class_type": "LoraLoaderModelOnly",
  "inputs": {"model": ["3", 0], "lora_name": "Qwen-Image-Lightning-8steps-V2.0-bf16.safetensors", "strength_model": 1},
  "_meta": {"title": "加载 Qwen 八步加速 LoRA"}
 },
 "5": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {"model": ["4", 0], "shift": 3},
  "_meta": {"title": "设置模型采样偏移"}
 },
 "6": {
  "class_type": "CFGNorm",
  "inputs": {"model": ["5", 0], "strength": 1, "pre_cfg": false},
  "_meta": {"title": "引导强度归一化"}
 },
 "7": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {"width": 1024, "height": 1024, "batch_size": 1},
  "_meta": {"title": "创建画布潜空间"}
 },
 "8": {
  "class_type": "CLIPTextEncode",
  "inputs": {"clip": ["2", 0], "text": ""},
  "_meta": {"title": "正向提示词"}
 },
 "9": {
  "class_type": "CLIPTextEncode",
  "inputs": {"clip": ["2", 0], "text": "低分辨率，低画质，肢体畸形，手指畸形，画面过饱和，蜡像感，人脸无细节，过度光滑，画面具有AI感。构图混乱。文字模糊，扭曲。"},
  "_meta": {"title": "负向提示词"}
 },
 "10": {
  "class_type": "KSampler",
  "inputs": {"model": ["6", 0], "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["7", 0], "seed": 79879643192314, "steps": 6, "cfg": 1.5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1},
  "_meta": {"title": "第一阶段采样"}
 },
 "11": {
  "class_type": "LatentUpscaleBy",
  "inputs": {"samples": ["10", 0], "upscale_method": "nearest-exact", "scale_by": 1},
  "_meta": {"title": "阶段间潜空间缩放"}
 },
 "12": {
  "class_type": "KSampler",
  "inputs": {"model": ["6", 0], "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["11", 0], "seed": 187838009409191, "steps": 2, "cfg": 1.5, "sampler_name": "euler", "scheduler": "simple", "denoise": 1},
  "_meta": {"title": "第二阶段细化采样"}
 },
 "13": {
  "class_type": "VAEDecode",
  "inputs": {"samples": ["12", 0], "vae": ["1", 0]},
  "_meta": {"title": "最终图像解码"}
 },
 "16": {
  "class_type": "SaveImage",
  "inputs": {"images": ["13", 0], "filename_prefix": "Qwen2512_文生图"},
  "_meta": {"title": "保存双阶段生成图像"}
 }
}
