From 05c58e0fcd8905e070824384d709004aa7d790de Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E7=A6=BE=E5=B0=9A?= <heshang.ys@alibaba-inc.com>
Date: Sun, 1 Nov 2026 16:00:32 +0800
Subject: [PATCH] Report custom ComfyUI build version from running service

Keep the upstream version unchanged and expose the imported 0.37.0+chouka.1 build identity so nodes updated on disk are not mistaken for restarted services.
---
 comfyui_version.py                            |  1 +
 server.py                                     |  3 +-
 .../jobs_cancel_test/memory_cleanup_test.py   | 38 ++++++++++++++++++-
 3 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/comfyui_version.py b/comfyui_version.py
index 046f3e3a..779d8d86 100644
--- a/comfyui_version.py
+++ b/comfyui_version.py
@@ -1,3 +1,4 @@
 # This file is automatically generated by the build process when version is
 # updated in pyproject.toml.
 __version__ = "0.37.0"
+__build_version__ = "0.37.0+chouka.1"
diff --git a/server.py b/server.py
index 734145ff..b93ce174 100644
--- a/server.py
+++ b/server.py
@@ -41,7 +41,7 @@ import comfy.model_management
 from comfy_api import feature_flags
 from comfy.comfy_api_env import get_environment_overrides
 import node_helpers
-from comfyui_version import __version__
+from comfyui_version import __version__, __build_version__
 from app.frontend_management import FrontendManager, parse_version
 from comfy_api.internal import _ComfyNodeInternal
 from app.assets.services.asset_management import resolve_hash_to_path
@@ -742,6 +742,7 @@ class PromptServer():
                     "ram_total": ram_total,
                     "ram_free": ram_free,
                     "comfyui_version": __version__,
+                    "comfyui_build_version": __build_version__,
                     "required_frontend_version": required_frontend_version,
                     "installed_templates_version": installed_templates_version,
                     "required_templates_version": required_templates_version,
diff --git a/tests-unit/jobs_cancel_test/memory_cleanup_test.py b/tests-unit/jobs_cancel_test/memory_cleanup_test.py
index c71f837d..6521b60a 100644
--- a/tests-unit/jobs_cancel_test/memory_cleanup_test.py
+++ b/tests-unit/jobs_cancel_test/memory_cleanup_test.py
@@ -10,6 +10,7 @@ import copy
 import heapq
 import json
 import logging
+import os
 import threading
 import time
 import uuid
@@ -17,7 +18,7 @@ from concurrent.futures import Future, ThreadPoolExecutor
 from pathlib import Path
 from types import SimpleNamespace
 from typing import List, Literal, NamedTuple, Optional
-from unittest.mock import AsyncMock, Mock
+from unittest.mock import AsyncMock, Mock, patch
 
 import pytest
 from aiohttp import ClientTimeout, web
@@ -38,6 +39,41 @@ def load_definitions(filename, names, namespace):
     exec(compile(ast.Module(body=definitions, type_ignores=[]), str(ROOT / filename), "exec"), namespace)
 
 
+def test_system_stats_reports_imported_comfy_build_version_without_reading_disk():
+    versions = {}
+    exec(compile((ROOT / "comfyui_version.py").read_text(encoding="utf-8"),
+                 str(ROOT / "comfyui_version.py"), "exec"), versions)
+    assert versions["__version__"] == "0.37.0"
+    assert versions["__build_version__"] == "0.37.0+chouka.1"
+    device = SimpleNamespace(type="cpu", index=None)
+    management = SimpleNamespace(
+        get_torch_device=lambda: device,
+        torch=SimpleNamespace(device=lambda name: device),
+        get_all_torch_devices=lambda: [device],
+        get_total_memory=lambda dev, torch_total_too=False: (1024, 1024) if torch_total_too else 1024,
+        get_free_memory=lambda dev, torch_free_too=False: (512, 512) if torch_free_too else 512,
+        get_torch_device_name=lambda dev: "CPU", torch_version="test",
+    )
+    namespace = dict(
+        __version__=versions["__version__"], __build_version__=versions["__build_version__"],
+        routes=web.RouteTableDef(), comfy=SimpleNamespace(model_management=management),
+        FrontendManager=SimpleNamespace(
+            get_required_frontend_version=lambda: "test",
+            get_installed_templates_version=lambda: "test",
+            get_required_templates_version=lambda: "test", get_comfy_package_versions=lambda: {},
+        ),
+        sys=SimpleNamespace(platform="test", version="test", executable="python", argv=[]),
+        os=os, web=web, get_deploy_environment=lambda: "test",
+    )
+    load_definitions("server.py", ["system_stats"], namespace)
+    versions["__build_version__"] = "not-loaded-yet"
+    with patch.object(Path, "read_text", side_effect=AssertionError("must report the loaded version")):
+        response = asyncio.run(namespace["system_stats"](None))
+    system = json.loads(response.text)["system"]
+    assert system["comfyui_version"] == "0.37.0"
+    assert system["comfyui_build_version"] == "0.37.0+chouka.1"
+
+
 @pytest.fixture
 def runtime():
     management = SimpleNamespace(unload_all_models=Mock(), soft_empty_cache=Mock())
