From 8aafce8a089f88e64d1cbc01ba65ce8e184c6e38 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E7=A6=BE=E5=B0=9A?= <heshang.ys@alibaba-inc.com>
Date: Sun, 1 Nov 2026 02:25:58 +0800
Subject: [PATCH] Preserve H3 reference video endings with repeated-frame
 alignment

Pad the resized reference to the next model frame grid instead of dropping its tail, while retaining the real audio interval.
---
 comfy_extras/nodes_minimax_h3.py     |  6 +-
 tests-unit/test_minimax_h3_memory.py | 96 ++++++++++++++++++++++------
 2 files changed, 82 insertions(+), 20 deletions(-)

diff --git a/comfy_extras/nodes_minimax_h3.py b/comfy_extras/nodes_minimax_h3.py
index c088a0aa..b0b932c4 100644
--- a/comfy_extras/nodes_minimax_h3.py
+++ b/comfy_extras/nodes_minimax_h3.py
@@ -324,10 +324,12 @@ class MiniMaxH3ReferenceToVideo(io.ComfyNode):
             n = min(video_frames.shape[0], frame_count)
             if n < 5:
                 raise ValueError("MiniMax H3 reference videos need at least 5 frames (~0.2s at 24 fps)")
-            n -= (n - 5) % 17
             frames = _resize(video_frames[:n], cw, ch, "disabled")
+            padded_count = align_frame_count(n)
+            if padded_count > n:
+                frames = torch.cat((frames, frames[-1:].expand(padded_count - n, -1, -1, -1)), dim=0)
             if soundtrack is not None:
-                # Keep the paired soundtrack on the same retained 24 fps interval.
+                # Keep audio on the retained real-frame interval, without tail padding.
                 soundtrack = dict(soundtrack)
                 audio_length = round(n / FPS * soundtrack["sample_rate"])
                 soundtrack["waveform"] = soundtrack["waveform"][..., :audio_length]
