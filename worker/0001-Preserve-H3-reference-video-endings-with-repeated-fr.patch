                 clip.tokenize.assert_called_once_with("test", minimax_ref_items=[])
 
-        def run_reference(self, source_frames, target_frames, kept_frames, sample_rate=240, audio_samples=None):
+        def run_reference(self, source_frames, target_frames, kept_frames, padded_frames, sample_rate=240, audio_samples=None):
