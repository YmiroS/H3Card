             video = levels[:, None, None, None].expand(-1, 2, 2, 3).clone()
             video_before = video.clone()
@@ -140,8 +140,16 @@ if __name__ == "__main__":
             audio_vae = Mock()
             audio_vae.audio_sample_rate = 240
             audio_vae.encode.side_effect = lambda waveform: torch.zeros(1, 32, 2, round(waveform.shape[1] / 240 * 40))
-            # Spy, not a replacement: real resize, resample and encode helper execute.
-            with patch.object(ref_nodes, "_resize", wraps=ref_nodes._resize) as resize:
+            # Capture the real resize output to check padding and the no-copy aligned path.
+            resized_batches = []
+            real_resize = ref_nodes._resize
+
+            def record_resize(*args, **kwargs):
+                resized = real_resize(*args, **kwargs)
+                resized_batches.append(resized)
+                return resized
+
+            with patch.object(ref_nodes, "_resize", side_effect=record_resize) as resize:
                 positive, latent = ref_nodes.MiniMaxH3ReferenceToVideo.execute(
                     clip=clip, vae=vae, audio_vae=audio_vae, prompt="<Video 1> <Audio 1>",
                     width=32, height=32, length=target_frames,
@@ -151,16 +159,27 @@ if __name__ == "__main__":
             self.assertEqual(resize.call_count, 1)
             retained = resize.call_args.args[0]
             self.assertEqual(len(retained), kept_frames)
-            self.assertEqual((len(retained) - 5) % 17, 0)
             self.assertLessEqual(len(retained), source_frames)
             torch.testing.assert_close(retained, video[:kept_frames])
             encoded_frames = vae.encode.call_args.args[0]
-            self.assertEqual(tuple(encoded_frames.shape), (kept_frames, 32, 32, 3))
+            self.assertEqual(tuple(encoded_frames.shape), (padded_frames, 32, 32, 3))
+            self.assertEqual((padded_frames - 5) % 17, 0)
+            torch.testing.assert_close(encoded_frames[:kept_frames], resized_batches[0], rtol=0, atol=0)
             # The real PIL Lanczos path quantizes to 8-bit image values.
-            torch.testing.assert_close(encoded_frames[:, 0, 0, 0], levels[:kept_frames], rtol=0, atol=1 / 255)
+            expected_frames = levels[:kept_frames, None, None, None].expand(-1, 32, 32, 3)
+            torch.testing.assert_close(encoded_frames[:kept_frames], expected_frames, rtol=0, atol=1 / 255)
+            if padded_frames > kept_frames:
+                torch.testing.assert_close(
+                    encoded_frames[kept_frames:],
+                    resized_batches[0][-1:].expand(padded_frames - kept_frames, -1, -1, -1),
+                    rtol=0, atol=0,
+                )
+            else:
+                self.assertIs(encoded_frames, resized_batches[0])
             block = positive[0][1]["minimax_refs"][0]
             self.assertEqual(block["kind"], "video_audio")
-            self.assertEqual(block["latent_t"], 2 + 5 * ((kept_frames - 5) // 17))
+            self.assertEqual(block["latent_t"], 2 + 5 * ((padded_frames - 5) // 17))
+            self.assertEqual(tuple(block["latent"].shape), (1, 24, block["latent_t"], 2, 2))
             self.assertEqual((block["latent_h"], block["latent_w"]), (2, 2))
             audio_input = audio_vae.encode.call_args.args[0]
             retained_samples = min(audio_samples, round(kept_frames / 24 * sample_rate))
@@ -175,7 +194,8 @@ if __name__ == "__main__":
             torch.testing.assert_close(items[1]["data"], encoded_frames[::12])
             self.assertEqual(items[1]["timestamps"], [i / 2 for i in range(len(encoded_frames[::12]))])
             target_count = target_frames + (5 - target_frames) % 17
-            self.assertLessEqual(kept_frames, target_count)
+            self.assertEqual(kept_frames, min(source_frames, target_count))
+            self.assertLessEqual(padded_frames, target_count)
             self.assertEqual(latent["samples"].tensors[0].shape[2], 2 + 5 * ((target_count - 5) // 17))
             self.assertEqual(latent["samples"].tensors[1].shape[-1], round(target_count / 24 * 40))
             self.assertIs(soundtrack["waveform"], original_waveform)
