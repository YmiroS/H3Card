+            positive, _ = ref_nodes.MiniMaxH3ReferenceToVideo.execute(
+                clip=clip, audio_vae=audio_vae, prompt="", width=32, height=32, length=124,
+                ref_videos=videos, ref_video_audios={"ref_video_audio_1": soundtrack},
